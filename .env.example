# Prévia: npm start. Banco persistente local em .data/preview (não publicar).
PORT=4175
HOST=127.0.0.1
# DATABASE_URL vem de .env.local, escrito e mantido por `neon init` (projeto
# volta-central, São Paulo). Não repita a URL aqui. Os scripts de produção,
# vínculo e backup leem .env e depois .env.local; a prévia lê só .env.
# Fora da prévia, obrigatórios. Configure o provedor real antes de produção.
# PUBLIC_ORIGIN=https://central.seu-dominio
# OIDC_ISSUER=https://seu-provedor
# OIDC_CLIENT_ID=volta
# OIDC_CLIENT_SECRET=segredo-fora-do-git
# OIDC redirect URI: PUBLIC_ORIGIN/auth/callback
