{
  "name": "volta-central",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env server.cjs --preview",
    "start:production": "node --env-file-if-exists=.env --env-file-if-exists=.env.local server.cjs",
    "check": "tsc --noEmit && node scripts/check.mjs",
    "test": "node --test tests/integration/*.mjs",
    "test:ui": "node tests/e2e/platform-ui.mjs",
    "member:bind": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/admin/bind-member.mts",
    "backup": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/admin/backup.mts",
    "demo:seed": "node scripts/demo/seed-preview.mjs",
    "demo:check": "node scripts/demo/check-demo.mjs",
    "test:studio": "node tests/e2e/studio.mjs"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "@fastify/cookie": "^11.1.5",
    "@fastify/rate-limit": "^11.2.2",
    "fastify": "^5.12.8",
    "openid-client": "^6.8.9",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "typescript": "5.9.3"
  }
}
